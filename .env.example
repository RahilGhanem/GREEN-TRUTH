# GreenTruth — environment variables
#
# EVERY VARIABLE HERE IS OPTIONAL.
# The core product — claim detection, decomposition, field resolution, real
# observation retrieval, uncertainty, trajectory, evidence sufficiency, the
# evidence chain and the map — runs with none of them set.
#
# Copy to .env and fill in only what you need.  NEVER commit a filled-in .env.

# ---------------------------------------------------------------- detector
# Which claim detector to use: auto | climatebert | rule_based
#   auto        try ClimateBERT, fall back to rules and REPORT the fallback
#   climatebert force the model (raises if transformers is not installed)
#   rule_based  force the offline rules
# Using ClimateBERT additionally requires:  pip install "transformers>=4.45" torch
GREENTRUTH_DETECTOR=auto

# ------------------------------------------------------------ hugging face
# Only needed to RE-UPLOAD a model. The published detector
# (Rahilgh/greentruth-claim-detector) is public, so inference needs no token.
HF_TOKEN=

# -------------------------------------------------------------- earth engine
# Only needed for the OPTIONAL Sentinel-5P methane cross-check, which is
# produced by notebook 03 Part B. Without it the app reports
# "methane cross-check unavailable" rather than inventing observations.
GEE_PROJECT=

# --------------------------------------------------------------------- CORS
# Set only if the frontend is served from a different origin than the API.
# Left unset, the server is same-origin and sends no CORS headers.
GREENTRUTH_CORS_ORIGIN=
