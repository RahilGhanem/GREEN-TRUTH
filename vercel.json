{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api/index?__gt_path=:path" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{web/**,notebooks/**,docs/**,tests/**,scripts/**,**/*.md,**/*.ipynb}"
    }
  }
}
